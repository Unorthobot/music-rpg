{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["apps/web/src/*"],
      "@music-rpg/shared": ["packages/shared/src/index.ts"],
      "@music-rpg/shared/*": ["packages/shared/src/*"],
      "@music-rpg/ui": ["packages/ui/src/index.ts"],
      "@music-rpg/ui/*": ["packages/ui/src/*"],
      "@music-rpg/domain": ["packages/domain/src/index.ts"],
      "@music-rpg/domain/*": ["packages/domain/src/*"],
      "@music-rpg/simulation": ["packages/simulation/src/index.ts"],
      "@music-rpg/simulation/*": ["packages/simulation/src/*"],
      "@music-rpg/events": ["packages/events/src/index.ts"],
      "@music-rpg/events/*": ["packages/events/src/*"],
      "@music-rpg/ai": ["packages/ai/src/index.ts"],
      "@music-rpg/ai/*": ["packages/ai/src/*"],
      "@music-rpg/database": ["packages/database/src/index.ts"],
      "@music-rpg/database/*": ["packages/database/src/*"],
      "@music-rpg/jobs": ["packages/jobs/src/index.ts"],
      "@music-rpg/jobs/*": ["packages/jobs/src/*"],
      "@music-rpg/analytics": ["packages/analytics/src/index.ts"],
      "@music-rpg/analytics/*": ["packages/analytics/src/*"],
      "@music-rpg/moderation": ["packages/moderation/src/index.ts"],
      "@music-rpg/moderation/*": ["packages/moderation/src/*"],
      "@music-rpg/storage": ["packages/storage/src/index.ts"],
      "@music-rpg/storage/*": ["packages/storage/src/*"],
      "@music-rpg/auth": ["packages/auth/src/index.ts"],
      "@music-rpg/auth/*": ["packages/auth/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
