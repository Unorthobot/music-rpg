{
  "name": "music-rpg",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @music-rpg/web",
    "build": "npm run build --workspace @music-rpg/web",
    "start": "npm run start --workspace @music-rpg/web",
    "lint": "npm run lint --workspace @music-rpg/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "db:migrate": "tsx packages/database/src/seed/migrate.ts",
    "db:migrate:check": "tsx packages/database/src/seed/migrate.ts --check",
    "db:seed": "tsx packages/database/src/seed/run.ts",
    "db:reset": "tsx packages/database/src/seed/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
