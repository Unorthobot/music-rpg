# --- Database -------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded PGlite database (local dev/test).
# Set it to a Postgres connection string to run against hosted Postgres.
# DATABASE_URL=postgresql://user:password@host:5432/music_rpg
#
# Where the embedded PGlite database persists when DATABASE_URL is unset.
PGLITE_DATA_DIR=.pglite/dev

# --- Auth -----------------------------------------------------------------
# 32+ char secret used to sign session cookies. Required in production.
AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789

# --- World Control (internal debug surface) --------------------------------
# Comma-separated emails allowed into /world-control.
WORLD_CONTROL_EMAILS=

# --- Analytics ------------------------------------------------------------
# console | noop
ANALYTICS_ADAPTER=console

# --- AI (not required for M0/M1) ------------------------------------------
# null | anthropic
AI_PROVIDER=null
# ANTHROPIC_API_KEY=

# --- Object storage (no assets generated in M0/M1) ------------------------
# memory | local
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
